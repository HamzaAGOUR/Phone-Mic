<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 forces edge-to-edge for apps targeting SDK 35. This simple
         single-screen app keeps the legacy layout so its content is not drawn
         underneath the status and navigation bars. -->
    <style name="Theme.PhoneMic" parent="@style/Base.Theme.PhoneMic">
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
