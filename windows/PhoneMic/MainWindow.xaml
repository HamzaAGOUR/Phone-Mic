<Window x:Class="PhoneMic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone Mic"
        Width="520"
        Height="700"
        MinHeight="420"
        Icon="app.ico"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="26">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="46"
                        Height="46"
                        VerticalAlignment="Center"
                        Source="Assets/app-logo-256.png" />

                    <StackPanel
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="27"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Phone Mic" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="14"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Use your phone as a PC microphone" />
                    </StackPanel>
                </StackPanel>

                <!-- PC address and connection status. -->
                <Border
                    Margin="0,22,0,0"
                    Padding="22"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource SectionLabelStyle}"
                            Text="PC IP ADDRESS" />

                        <TextBlock
                            x:Name="IpAddressText"
                            Margin="0,5,0,0"
                            FontFamily="Consolas"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Checking..." />

                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="13"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="UDP port 48123" />

                        <Border
                            Margin="0,18,0,0"
                            Padding="14,13"
                            Background="#F8FAFC"
                            CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Ellipse
                                    x:Name="StatusDot"
                                    Width="10"
                                    Height="10"
                                    VerticalAlignment="Center"
                                    Fill="#94A3B8" />

                                <TextBlock
                                    x:Name="StatusText"
                                    Grid.Column="1"
                                    Margin="11,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="Starting…"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- Live level from the phone's microphone. A stream of
                             exact digital silence usually means the phone's mic
                             is muted or blocked by an Android privacy setting. -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Style="{StaticResource SectionLabelStyle}"
                                Text="MIC LEVEL" />

                            <TextBlock
                                x:Name="MicLevelText"
                                Grid.Column="1"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="0%" />
                        </Grid>

                        <Border
                            x:Name="MicLevelTrack"
                            Height="10"
                            Margin="0,7,0,0"
                            Background="#E2E8F0"
                            ClipToBounds="True"
                            CornerRadius="5">
                            <Border
                                x:Name="MicLevelFill"
                                Width="0"
                                HorizontalAlignment="Left"
                                Background="#2563EB"
                                CornerRadius="5" />
                        </Border>

                        <TextBlock
                            x:Name="SilentMicHint"
                            Margin="0,10,0,0"
                            FontSize="12"
                            Foreground="#B45309"
                            Text="The phone is connected but sending silence. Check the microphone mute or privacy setting on the phone, and make sure no other app is using the microphone."
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Output selection and VB-Cable guidance. -->
                <Border
                    Margin="0,16,0,0"
                    Padding="22"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource SectionLabelStyle}"
                            Text="MICROPHONE OUTPUT" />

                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="13"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TextWrapping="Wrap"
                            Text="Phone Mic plays into this device. Choose CABLE Input so other apps can use CABLE Output as a microphone." />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                x:Name="OutputDeviceComboBox"
                                MinHeight="36"
                                Padding="8,6"
                                VerticalContentAlignment="Center"
                                DisplayMemberPath="Name"
                                FontSize="13"
                                SelectionChanged="OnOutputDeviceChanged" />

                            <Button
                                x:Name="RefreshDevicesButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Content="Refresh"
                                Click="OnRefreshDevicesClicked"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <CheckBox
                            x:Name="TestWithSpeakersCheckBox"
                            Margin="0,12,0,0"
                            Checked="OnTestWithSpeakersChanged"
                            Content="Test with speakers instead"
                            FontSize="13"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Unchecked="OnTestWithSpeakersChanged" />

                        <Border
                            x:Name="VbCableWarningPanel"
                            Margin="0,14,0,0"
                            Padding="14"
                            Background="#FFF7ED"
                            BorderBrush="#FDBA74"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#9A3412"
                                    Text="VB-Cable not found" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    FontSize="12"
                                    Foreground="#9A3412"
                                    TextWrapping="Wrap"
                                    Text="Install the free VB-Cable driver so Discord, Zoom, and OBS can use Phone Mic as a microphone." />
                                <Button
                                    x:Name="GetVbCableButton"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Click="OnGetVbCableClicked"
                                    Content="Get VB-Cable"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock
                            x:Name="OutputMessageText"
                            Margin="0,12,0,0"
                            FontSize="12"
                            Foreground="#B91C1C"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Short instructions for the receiving applications. -->
                <Border
                    Margin="0,16,0,0"
                    Padding="20"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource SectionLabelStyle}"
                            Text="USE IT AS A MICROPHONE" />

                        <TextBlock
                            Margin="0,9,0,0"
                            FontSize="13"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="1. " />Keep <Run FontWeight="SemiBold" Text="CABLE Input" /> selected above.
                        </TextBlock>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="13"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="2. " />In Discord, Zoom, or OBS, choose <Run FontWeight="SemiBold" Text="CABLE Output" /> as the microphone.
                        </TextBlock>
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="Do not choose CABLE Output in Phone Mic itself; Phone Mic sends audio into CABLE Input." />
                    </StackPanel>
                </Border>

                <TextBlock
                    Margin="2,16,2,0"
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    TextWrapping="Wrap">
                    First launch: if Windows Security asks about network access, choose <Run FontWeight="SemiBold" Text="Allow" />. Windows needs this so your phone can reach the PC.
                </TextBlock>

                <TextBlock
                    Margin="2,24,2,0"
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    TextWrapping="Wrap">
                    Made by <Run FontWeight="SemiBold" Text="Hamza AGOUR" />
                    <Run Text=" · " />
                    <Hyperlink
                        Foreground="#2563EB"
                        NavigateUri="https://github.com/HamzaAGOUR/Phone-Mic"
                        RequestNavigate="OnRepositoryLinkClicked">github.com/HamzaAGOUR/Phone-Mic</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
